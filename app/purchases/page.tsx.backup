'use client'

import { useEffect, useMemo, useState } from 'react'
import { createClient } from '@/lib/supabase/client'

type Supplier = {
  id: string
  name: string
  phone: string | null
  address: string | null
}

type Product = {
  id: string
  name: string
  purchase_price: number
  gst_percent: number
  stock_qty: number
}

type PurchaseItem = {
  product_id: string
  quantity: number
  purchase_price: number
  gst_percent: number
}

export default function PurchasesPage() {
  const supabase = createClient()

  const [suppliers, setSuppliers] = useState<Supplier[]>([])
  const [products, setProducts] = useState<Product[]>([])

  const [supplierId, setSupplierId] = useState('')
  const [invoiceNumber, setInvoiceNumber] = useState('')
  const [discount, setDiscount] = useState(0)
  const [paidAmount, setPaidAmount] = useState(0)
  const [notes, setNotes] = useState('')

  const [items, setItems] = useState<PurchaseItem[]>([
    {
      product_id: '',
      quantity: 1,
      purchase_price: 0,
      gst_percent: 0,
    },
  ])

  const [message, setMessage] = useState('')
  const [saving, setSaving] = useState(false)

  const [showSupplierForm, setShowSupplierForm] = useState(false)
  const [editingSupplier, setEditingSupplier] = useState<Supplier | null>(null)
  const [supplierName, setSupplierName] = useState('')
  const [supplierPhone, setSupplierPhone] = useState('')
  const [supplierAddress, setSupplierAddress] = useState('')
  const [supplierSaving, setSupplierSaving] = useState(false)

  async function loadData() {
    const { data: supplierData, error: supplierError } =
      await supabase
        .from('suppliers')
        .select('id,name,phone,address')
        .order('name')

    if (supplierError) {
      setMessage('Supplier Error: ' + supplierError.message)
      return
    }

    const { data: productData, error: productError } =
      await supabase
        .from('products')
        .select('id,name,purchase_price,gst_percent,stock_qty')
        .order('name')

    if (productError) {
      setMessage('Product Error: ' + productError.message)
      return
    }

    setSuppliers(supplierData ?? [])
    setProducts(productData ?? [])
  }

  useEffect(() => {
    loadData()
  }, [])

  function selectProduct(index: number, productId: string) {
    const product = products.find((p) => p.id === productId)

    setItems((current) =>
      current.map((item, i) =>
        i === index
          ? {
              ...item,
              product_id: productId,
              purchase_price: product?.purchase_price ?? 0,
              gst_percent: product?.gst_percent ?? 0,
            }
          : item
      )
    )
  }

  function updateItem(
    index: number,
    field: 'quantity' | 'purchase_price' | 'gst_percent',
    value: number
  ) {
    setItems((current) =>
      current.map((item, i) =>
        i === index
          ? { ...item, [field]: value }
          : item
      )
    )
  }

  function addItem() {
    setItems((current) => [
      ...current,
      {
        product_id: '',
        quantity: 1,
        purchase_price: 0,
        gst_percent: 0,
      },
    ])
  }

  function removeItem(index: number) {
    if (items.length === 1) return

    setItems((current) =>
      current.filter((_, i) => i !== index)
    )
  }

  const calculations = useMemo(() => {
    let subtotal = 0
    let gstAmount = 0

    const calculatedItems = items.map((item) => {
      const lineSubtotal =
        Number(item.quantity || 0) *
        Number(item.purchase_price || 0)

      const lineGst =
        lineSubtotal *
        Number(item.gst_percent || 0) /
        100

      const lineTotal = lineSubtotal + lineGst

      subtotal += lineSubtotal
      gstAmount += lineGst

      return {
        ...item,
        lineSubtotal,
        lineGst,
        lineTotal,
      }
    })

    const grandTotal = Math.max(
      0,
      subtotal + gstAmount - Number(discount || 0)
    )

    const dueAmount = Math.max(
      0,
      grandTotal - Number(paidAmount || 0)
    )

    return {
      calculatedItems,
      subtotal,
      gstAmount,
      grandTotal,
      dueAmount,
    }
  }, [items, discount, paidAmount])

  function openAddSupplier() {
    setEditingSupplier(null)
    setSupplierName('')
    setSupplierPhone('')
    setSupplierAddress('')
    setShowSupplierForm(true)
  }

  function openEditSupplier() {
    const supplier = suppliers.find((s) => s.id === supplierId)
    if (!supplier) return

    setEditingSupplier(supplier)
    setSupplierName(supplier.name)
    setSupplierPhone(supplier.phone ?? '')
    setSupplierAddress(supplier.address ?? '')
    setShowSupplierForm(true)
  }

  async function saveSupplier() {
    if (!supplierName.trim()) {
      setMessage('Supplier name required hai.')
      return
    }

    setSupplierSaving(true)
    setMessage('')

    try {
      if (editingSupplier) {
        const { error } = await supabase
          .from('suppliers')
          .update({
            name: supplierName.trim(),
            phone: supplierPhone.trim() || null,
            address: supplierAddress.trim() || null,
          })
          .eq('id', editingSupplier.id)

        if (error) throw new Error(error.message)
      } else {
        const { data, error } = await supabase
          .from('suppliers')
          .insert({
            business_id: 'fc98ba38-bf25-4268-98ba-aad43ecfa6d3',
            name: supplierName.trim(),
            phone: supplierPhone.trim() || null,
            address: supplierAddress.trim() || null,
          })
          .select()
          .single()

        if (error) throw new Error(error.message)

        if (data) {
          setSupplierId(data.id)
        }
      }

      setShowSupplierForm(false)
      setEditingSupplier(null)
      setSupplierName('')
      setSupplierPhone('')
      setSupplierAddress('')

      await loadData()
      setMessage(editingSupplier ? 'Supplier updated successfully.' : 'Supplier added successfully.')
    } catch (error) {
      setMessage(
        error instanceof Error ? error.message : 'Supplier save failed.'
      )
    } finally {
      setSupplierSaving(false)
    }
  }

  async function deleteSupplier() {
    const supplier = suppliers.find((s) => s.id === supplierId)
    if (!supplier) return

    const confirmed = window.confirm(
      `Delete supplier "${supplier.name}"?`
    )

    if (!confirmed) return

    setSupplierSaving(true)
    setMessage('')

    try {
      const { error } = await supabase
        .from('suppliers')
        .delete()
        .eq('id', supplier.id)

      if (error) throw new Error(error.message)

      setSupplierId('')
      setSuppliers((current) =>
        current.filter((item) => item.id !== supplier.id)
      )
      setEditingSupplier(null)
      setSupplierName('')
      setSupplierPhone('')
      setSupplierAddress('')
      setShowSupplierForm(false)
      await loadData()
      setMessage('Supplier deleted successfully.')
    } catch (error) {
      setMessage(
        error instanceof Error ? error.message : 'Supplier delete failed.'
      )
    } finally {
      setSupplierSaving(false)
    }
  }

  async function savePurchase() {
    setMessage('')

    if (!supplierId) {
      setMessage('Supplier select karo.')
      return
    }

    const validItems = items.filter(
      (item) =>
        item.product_id &&
        Number(item.quantity) > 0
    )

    if (validItems.length === 0) {
      setMessage('Kam se kam 1 product add karo.')
      return
    }

    if (Number(paidAmount) > calculations.grandTotal) {
      setMessage('Paid amount Grand Total se zyada nahi ho sakta.')
      return
    }

    setSaving(true)

    try {
      const { data: purchase, error: purchaseError } =
        await supabase
          .from('purchases')
          .insert({
            supplier_id: supplierId,
            invoice_number: invoiceNumber || null,
            subtotal: calculations.subtotal,
            gst_amount: calculations.gstAmount,
            discount: Number(discount || 0),
            total_amount: calculations.grandTotal,
            paid_amount: Number(paidAmount || 0),
            due_amount: calculations.dueAmount,
            notes: notes || null,
          })
          .select()
          .single()

      if (purchaseError) {
        throw new Error(purchaseError.message)
      }

      const purchaseItems = calculations.calculatedItems
        .filter((item) => item.product_id)
        .map((item) => ({
          purchase_id: purchase.id,
          product_id: item.product_id,
          quantity: Number(item.quantity),
          purchase_price: Number(item.purchase_price),
          gst_percent: Number(item.gst_percent),
          gst_amount: item.lineGst,
          line_total: item.lineTotal,
        }))

      const { error: itemsError } =
        await supabase
          .from('purchase_items')
          .insert(purchaseItems)

      if (itemsError) {
        throw new Error(itemsError.message)
      }

      for (const item of validItems) {
        const { error: stockError } =
          await supabase.rpc('add_stock_movement', {
            p_product_id: item.product_id,
            p_movement_type: 'purchase_in',
            p_quantity: Number(item.quantity),
            p_note: `Purchase ${invoiceNumber || purchase.id}`,
          })

        if (stockError) {
          throw new Error(stockError.message)
        }
      }

      setMessage(
        `Purchase saved successfully. Total ₹${calculations.grandTotal.toFixed(2)}`
      )

      setSupplierId('')
      setInvoiceNumber('')
      setDiscount(0)
      setPaidAmount(0)
      setNotes('')

      setItems([
        {
          product_id: '',
          quantity: 1,
          purchase_price: 0,
          gst_percent: 0,
        },
      ])

      await loadData()
    } catch (error) {
      setMessage(
        error instanceof Error
          ? error.message
          : 'Purchase save failed.'
      )
    } finally {
      setSaving(false)
    }
  }

  return (
    <main className="min-h-screen bg-gray-100 p-4">
      <div className="mx-auto max-w-6xl">

        <div className="mb-6">
          <h1 className="text-2xl font-bold text-gray-900">Purchase</h1>
          <p className="mt-1 text-gray-600">Purchase Invoice + GST + Stock</p>
        </div>

        {message && (
          <div className="mb-4 rounded-xl bg-white p-4 shadow">
            {message}
          </div>
        )}

        <div className="mb-4 rounded-xl bg-white p-4 shadow">
          <h2 className="mb-4 text-lg font-bold">Purchase Details</h2>

          <div className="grid gap-4 md:grid-cols-2">

            <div>
              <label className="mb-1 block text-sm font-medium">Supplier</label>

              <div className="flex gap-2">
                <select
                  value={supplierId}
                  onChange={(e) => setSupplierId(e.target.value)}
                  className="min-w-0 flex-1 rounded-lg border p-3"
                >
                  <option value="">Select Supplier</option>
                  {suppliers.map((supplier) => (
                    <option key={supplier.id} value={supplier.id}>
                      {supplier.name}
                    </option>
                  ))}
                </select>

                <button
                  type="button"
                  onClick={openAddSupplier}
                  className="rounded-lg bg-blue-600 px-4 py-2 text-white"
                >
                  + Add
                </button>

                <button
                  type="button"
                  onClick={openEditSupplier}
                  disabled={!supplierId}
                  className="rounded-lg bg-gray-600 px-3 py-2 text-white disabled:opacity-40"
                >
                  Edit
                </button>

                <button
                  type="button"
                  onClick={deleteSupplier}
                  disabled={!supplierId || supplierSaving}
                  className="rounded-lg bg-red-600 px-3 py-2 text-white disabled:opacity-40"
                >
                  Delete
                </button>
              </div>
            </div>

            <div>
              <label className="mb-1 block text-sm font-medium">
                Supplier Invoice Number
              </label>
              <input
                type="text"
                value={invoiceNumber}
                onChange={(e) => setInvoiceNumber(e.target.value)}
                className="w-full rounded-lg border p-3"
                placeholder="Invoice number"
              />
            </div>

          </div>

          {showSupplierForm && (
            <div className="mt-4 rounded-lg border bg-gray-50 p-4">
              <h3 className="mb-3 text-lg font-semibold">
                {editingSupplier ? "Edit Supplier" : "Add Supplier"}
              </h3>

              <div className="grid gap-3 md:grid-cols-3">
                <input
                  type="text"
                  placeholder="Supplier Name *"
                  value={supplierName}
                  onChange={(e) => setSupplierName(e.target.value)}
                  className="rounded-lg border p-3"
                />

                <input
                  type="text"
                  placeholder="Phone"
                  value={supplierPhone}
                  onChange={(e) => setSupplierPhone(e.target.value)}
                  className="rounded-lg border p-3"
                />

                <input
                  type="text"
                  placeholder="Address"
                  value={supplierAddress}
                  onChange={(e) => setSupplierAddress(e.target.value)}
                  className="rounded-lg border p-3"
                />
              </div>

              <div className="mt-3 flex gap-2">
                <button
                  type="button"
                  onClick={saveSupplier}
                  disabled={supplierSaving}
                  className="rounded-lg bg-green-600 px-4 py-2 text-white disabled:opacity-50"
                >
                  {supplierSaving ? "Saving..." : "Save Supplier"}
                </button>

                <button
                  type="button"
                  onClick={() => setShowSupplierForm(false)}
                  className="rounded-lg bg-gray-300 px-4 py-2"
                >
                  Cancel
                </button>
              </div>
            </div>
          )}
        </div>

        <div className="mb-4 rounded-xl bg-white p-4 shadow">
          <div className="mb-4 flex items-center justify-between">
            <h2 className="text-lg font-bold">Products</h2>

            <button
              type="button"
              onClick={addItem}
              className="rounded-lg bg-blue-600 px-4 py-2 text-white"
            >
              + Add Product
            </button>
          </div>

          <div className="space-y-3">
            {calculations.calculatedItems.map((item, index) => (
              <div
                key={index}
                className="grid gap-3 rounded-lg border p-3 md:grid-cols-6"
              >
                <select
                  value={item.product_id}
                  onChange={(e) => selectProduct(index, e.target.value)}
                  className="rounded-lg border p-3 md:col-span-2"
                >
                  <option value="">Select Product</option>
                  {products.map((product) => (
                    <option key={product.id} value={product.id}>
                      {product.name}
                    </option>
                  ))}
                </select>

                <input
                  type="number"
                  min="1"
                  value={item.quantity}
                  onChange={(e) =>
                    updateItem(index, "quantity", Number(e.target.value))
                  }
                  className="rounded-lg border p-3"
                  placeholder="Qty"
                />

                <input
                  type="number"
                  min="0"
                  value={item.purchase_price}
                  onChange={(e) =>
                    updateItem(index, "purchase_price", Number(e.target.value))
                  }
                  className="rounded-lg border p-3"
                  placeholder="Purchase Price"
                />

                <input
                  type="number"
                  min="0"
                  value={item.gst_percent}
                  onChange={(e) =>
                    updateItem(index, "gst_percent", Number(e.target.value))
                  }
                  className="rounded-lg border p-3"
                  placeholder="GST %"
                />

                <div className="flex items-center justify-between gap-2">
                  <span className="font-semibold">
                    ₹{item.lineTotal.toFixed(2)}
                  </span>

                  <button
                    type="button"
                    onClick={() => removeItem(index)}
                    disabled={items.length === 1}
                    className="rounded-lg bg-red-600 px-3 py-2 text-white disabled:opacity-40"
                  >
                    Remove
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div className="mb-4 grid gap-4 md:grid-cols-2">

          <div className="rounded-xl bg-white p-4 shadow">
            <label className="mb-1 block text-sm font-medium">Discount</label>
            <input
              type="number"
              min="0"
              value={discount}
              onChange={(e) => setDiscount(Number(e.target.value))}
              className="w-full rounded-lg border p-3"
            />

            <label className="mb-1 mt-4 block text-sm font-medium">
              Paid Amount
            </label>
            <input
              type="number"
              min="0"
              value={paidAmount}
              onChange={(e) => setPaidAmount(Number(e.target.value))}
              className="w-full rounded-lg border p-3"
            />

            <label className="mb-1 mt-4 block text-sm font-medium">
              Notes
            </label>
            <textarea
              value={notes}
              onChange={(e) => setNotes(e.target.value)}
              className="w-full rounded-lg border p-3"
              rows={3}
              placeholder="Notes"
            />
          </div>

          <div className="rounded-xl bg-white p-4 shadow">
            <h2 className="mb-4 text-lg font-bold">Purchase Summary</h2>

            <div className="space-y-2">
              <div className="flex justify-between">
                <span>Subtotal</span>
                <span>₹{calculations.subtotal.toFixed(2)}</span>
              </div>

              <div className="flex justify-between">
                <span>GST</span>
                <span>₹{calculations.gstAmount.toFixed(2)}</span>
              </div>

              <div className="flex justify-between">
                <span>Discount</span>
                <span>₹{Number(discount || 0).toFixed(2)}</span>
              </div>

              <div className="flex justify-between border-t pt-2 text-lg font-bold">
                <span>Grand Total</span>
                <span>₹{calculations.grandTotal.toFixed(2)}</span>
              </div>

              <div className="flex justify-between">
                <span>Paid</span>
                <span>₹{Number(paidAmount || 0).toFixed(2)}</span>
              </div>

              <div className="flex justify-between font-bold">
                <span>Due</span>
                <span>₹{calculations.dueAmount.toFixed(2)}</span>
              </div>
            </div>

            <button
              type="button"
              onClick={savePurchase}
              disabled={saving}
              className="mt-5 w-full rounded-lg bg-green-600 px-4 py-3 font-semibold text-white disabled:opacity-50"
            >
              {saving ? "Saving Purchase..." : "Save Purchase"}
            </button>
          </div>

        </div>
      </div>
    </main>
  )
}
