'use client'

import { useEffect, useMemo, useState } from 'react'
import { createClient } from '@/lib/supabase/client'

type Supplier = {
  id: string
  name: string
  phone: string | null
  address: string | null
}

type Product = {
  id: string
  name: string
  purchase_price: number
  gst_percent: number
  stock_qty: number
}

type PurchaseItem = {
  product_id: string
  quantity: number
  purchase_price: number
  gst_percent: number
}

export default function PurchasesPage() {
  const BUSINESS_ID = 'fc98ba38-bf25-4268-98ba-aad43ecfa6d3'

  async function savePurchase() {
    if (!items.length) {
      alert('Kam se kam 1 product add karo.')
      return
    }

    const subtotal = items.reduce(
      (sum, item) => sum + item.quantity * item.purchase_price,
      0
    )

    const taxableAmount = Math.max(0, subtotal - discount)
    const gstRateAmount = items.reduce(
      (sum, item) =>
        sum + item.quantity * item.purchase_price * item.gst_percent / 100,
      0
    )

    const totalAmount = Math.max(0, taxableAmount + gstRateAmount)
    const dueAmount = Math.max(0, totalAmount - paidAmount)

    const { data: purchase, error } = await supabase
      .from('purchases')
      .insert({
        business_id: BUSINESS_ID,
        supplier_id: supplierId || null,
        bill_no: invoiceNumber || null,
        subtotal,
        discount,
        taxable_amount: taxableAmount,
        cgst_amount: gstRateAmount / 2,
        sgst_amount: gstRateAmount / 2,
        igst_amount: 0,
        total_gst: gstRateAmount,
        total_amount: totalAmount,
        paid_amount: paidAmount,
        due_amount: dueAmount,
        payment_method: 'cash'
      })
      .select('id')
      .single()

    if (error) {
      alert(error.message)
      return
    }

    for (const item of items) {
      const lineTotal =
        item.quantity * item.purchase_price *
        (1 + item.gst_percent / 100)

      const { error: itemError } = await supabase
        .from('purchase_items')
        .insert({
          purchase_id: purchase.id,
          product_id: item.product_id,
          product_name:
            products.find(p => p.id === item.product_id)?.name || '',
          qty: item.quantity,
          price: item.purchase_price,
          discount: 0,
          taxable_amount: item.quantity * item.purchase_price,
          gst_percent: item.gst_percent,
          cgst_amount:
            item.quantity * item.purchase_price * item.gst_percent / 200,
          sgst_amount:
            item.quantity * item.purchase_price * item.gst_percent / 200,
          igst_amount: 0,
          line_total: lineTotal
        })

      if (itemError) {
        alert(itemError.message)
        return
      }

      const { error: stockError } = await supabase.rpc(
        'add_stock_movement',
        {
          p_product_id: item.product_id,
          p_movement_type: 'purchase_in',
          p_quantity: item.quantity,
          p_note: invoiceNumber || 'Purchase'
        }
      )

      if (stockError) {
        alert(stockError.message)
        return
      }
    }

    alert('Purchase saved successfully.')
  }


  const supabase = createClient()

  const [suppliers, setSuppliers] = useState<Supplier[]>([])
  const [products, setProducts] = useState<Product[]>([])

  const [supplierId, setSupplierId] = useState('')
  const [invoiceNumber, setInvoiceNumber] = useState('')
  const [discount, setDiscount] = useState(0)
  const [paidAmount, setPaidAmount] = useState(0)
  const [notes, setNotes] = useState('')

  const [items, setItems] = useState<PurchaseItem[]>([
    {
      product_id: '',
      quantity: 1,
      purchase_price: 0,
      gst_percent: 0,
    },
  ])

  const [message, setMessage] = useState('')
  const [saving, setSaving] = useState(false)

  const [showSupplierForm, setShowSupplierForm] = useState(false)
  const [editingSupplier, setEditingSupplier] =
    useState<Supplier | null>(null)

  const [supplierName, setSupplierName] = useState('')
  const [supplierPhone, setSupplierPhone] = useState('')
  const [supplierAddress, setSupplierAddress] = useState('')
  const [supplierSaving, setSupplierSaving] = useState(false)

  async function loadData() {
    setMessage('')

    const {
      data: supplierData,
      error: supplierError,
    } = await supabase
      .from('suppliers')
      .select('id, name, phone, address')
      .order('name')

    if (supplierError) {
      setMessage(`Supplier Error: ${supplierError.message}`)
      return
    }

    const {
      data: productData,
      error: productError,
    } = await supabase
      .from('products')
      .select(
        'id, name, purchase_price, gst_percent, stock_qty'
      )
      .order('name')

    if (productError) {
      setMessage(`Product Error: ${productError.message}`)
      return
    }

    setSuppliers(supplierData ?? [])
    setProducts(productData ?? [])
  }

  useEffect(() => {
    loadData()
  }, [])

  function selectProduct(index: number, productId: string) {
    const product = products.find((p) => p.id === productId)

    setItems((current) =>
      current.map((item, i) =>
        i === index
          ? {
              ...item,
              product_id: productId,
              purchase_price: product?.purchase_price ?? 0,
              gst_percent: product?.gst_percent ?? 0,
            }
          : item
      )
    )
  }

  function updateItem(
    index: number,
    field: 'quantity' | 'purchase_price' | 'gst_percent',
    value: number
  ) {
    setItems((current) =>
      current.map((item, i) =>
        i === index
          ? {
              ...item,
              [field]: value,
            }
          : item
      )
    )
  }

  function addItem() {
    setItems((current) => [
      ...current,
      {
        product_id: '',
        quantity: 1,
        purchase_price: 0,
        gst_percent: 0,
      },
    ])
  }

  function removeItem(index: number) {
    setItems((current) => {
      if (current.length === 1) {
        return current
      }

      return current.filter((_, i) => i !== index)
    })
  }

  const subtotal = useMemo(() => {
    return items.reduce(
      (sum, item) =>
        sum + item.quantity * item.purchase_price,
      0
    )
  }, [items])

  const gstAmount = useMemo(() => {
    return items.reduce(
      (sum, item) =>
        sum +
        (item.quantity *
          item.purchase_price *
          item.gst_percent) /
          100,
      0
    )
  }, [items])

  const grandTotal = useMemo(() => {
    return Math.max(
      0,
      subtotal + gstAmount - discount
    )
  }, [subtotal, gstAmount, discount])

  const dueAmount = useMemo(() => {
    return Math.max(0, grandTotal - paidAmount)
  }, [grandTotal, paidAmount])

  return (
    <main className="p-6">
      <h1 className="text-2xl font-bold">
        Purchase
      </h1>

      <p className="mt-2 text-gray-600">
        Purchase module is loading correctly.
      </p>

      {message && (
        <div className="mt-4 rounded border border-red-300 bg-red-50 p-3 text-red-700">
          {message}
        </div>
      )}

      <div className="mt-6 rounded-lg border p-4">
        <h2 className="text-lg font-semibold">
          Purchase Summary
        </h2>

        <div className="mt-4 grid gap-4 md:grid-cols-2">
          <div>
            <label className="block text-sm font-medium">
              Supplier
            </label>

            <select
              value={supplierId}
              onChange={(e) =>
                setSupplierId(e.target.value)
              }
              className="mt-1 w-full rounded border p-2"
            >
              <option value="">
                Select Supplier
              </option>

              {suppliers.map((supplier) => (
                <option
                  key={supplier.id}
                  value={supplier.id}
                >
                  {supplier.name}
                </option>
              ))}
            </select>
          </div>

          <div>
            <label className="block text-sm font-medium">
              Invoice Number
            </label>

            <input
              value={invoiceNumber}
              onChange={(e) =>
                setInvoiceNumber(e.target.value)
              }
              className="mt-1 w-full rounded border p-2"
              placeholder="Invoice number"
            />
          </div>
        </div>

        <div className="mt-6">
          <h2 className="text-lg font-semibold">
            Purchase Items
          </h2>

          <div className="mt-3 space-y-3">
            {items.map((item, index) => (
              <div
                key={index}
                className="grid gap-2 rounded border p-3 md:grid-cols-5"
              >
                <select
                  value={item.product_id}
                  onChange={(e) =>
                    selectProduct(
                      index,
                      e.target.value
                    )
                  }
                  className="rounded border p-2"
                >
                  <option value="">
                    Select Product
                  </option>

                  {products.map((product) => (
                    <option
                      key={product.id}
                      value={product.id}
                    >
                      {product.name}
                    </option>
                  ))}
                </select>

                <input
                  type="number"
                  min="1"
                  value={item.quantity}
                  onChange={(e) =>
                    updateItem(
                      index,
                      'quantity',
                      Number(e.target.value)
                    )
                  }
                  className="rounded border p-2"
                  placeholder="Quantity"
                />

                <input
                  type="number"
                  min="0"
                  value={item.purchase_price}
                  onChange={(e) =>
                    updateItem(
                      index,
                      'purchase_price',
                      Number(e.target.value)
                    )
                  }
                  className="rounded border p-2"
                  placeholder="Purchase Price"
                />

                <input
                  type="number"
                  min="0"
                  value={item.gst_percent}
                  onChange={(e) =>
                    updateItem(
                      index,
                      'gst_percent',
                      Number(e.target.value)
                    )
                  }
                  className="rounded border p-2"
                  placeholder="GST %"
                />

                <button
                  type="button"
                  onClick={() =>
                    removeItem(index)
                  }
                  className="rounded bg-red-600 px-3 py-2 text-white"
                >
                  Remove
                </button>
              </div>
            ))}
          </div>

          <button
            type="button"
            onClick={addItem}
            className="mt-4 rounded bg-blue-600 px-4 py-2 text-white"
          >
            + Add Item
          </button>
        </div>

        <div className="mt-6 grid gap-4 md:grid-cols-3">
          <div>
            <label className="block text-sm font-medium">
              Discount
            </label>

            <input
              type="number"
              min="0"
              value={discount}
              onChange={(e) =>
                setDiscount(Number(e.target.value))
              }
              className="mt-1 w-full rounded border p-2"
            />
          </div>

          <div>
            <label className="block text-sm font-medium">
              Paid Amount
            </label>

            <input
              type="number"
              min="0"
              value={paidAmount}
              onChange={(e) =>
                setPaidAmount(Number(e.target.value))
              }
              className="mt-1 w-full rounded border p-2"
            />
          </div>

          <div>
            <label className="block text-sm font-medium">
              Notes
            </label>

            <input
              value={notes}
              onChange={(e) =>
                setNotes(e.target.value)
              }
              className="mt-1 w-full rounded border p-2"
              placeholder="Notes"
            />
          </div>
        </div>

        <div className="mt-6 rounded-lg bg-gray-50 p-4">
          <div className="flex justify-between">
            <span>Subtotal</span>
            <span>₹{subtotal.toFixed(2)}</span>
          </div>

          <div className="mt-2 flex justify-between">
            <span>GST</span>
            <span>₹{gstAmount.toFixed(2)}</span>
          </div>

          <div className="mt-2 flex justify-between">
            <span>Discount</span>
            <span>₹{discount.toFixed(2)}</span>
          </div>

          <div className="mt-2 flex justify-between font-bold">
            <span>Grand Total</span>
            <span>₹{grandTotal.toFixed(2)}</span>
          </div>

          <div className="mt-2 flex justify-between">
            <span>Paid</span>
            <span>₹{paidAmount.toFixed(2)}</span>
          </div>

          <div className="mt-2 flex justify-between font-bold">
            <span>Due</span>
            <span>₹{dueAmount.toFixed(2)}</span>
          </div>
        </div>
      </div>
    </main>
  )
}
